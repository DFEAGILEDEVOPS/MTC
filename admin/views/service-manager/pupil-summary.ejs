<%- partial('partials/_gds_breadcrumbs_and_sign_out', { breadcrumbs }) %>
  <main class="govuk-main-wrapper govuk-body" id="main-content" role="main">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">
          <%=pupil.lastName %>, <%=pupil.firstName %>
        </h1>
        <%- partial('partials/_gds_session_expiry') %>
          <%- partial('partials/_flash-messages') %>
          <%- partial('partials/service-manager/pupil/_pupil-summary', { pupil }) %>
      </div>
      <div class="govuk-grid-column-one-third" aria-label="sidebar">
        <aside class="app-related-items" role="complementary">
          <h2 class="govuk-heading-m" id="subsection-title">
            Related
          </h2>
          <nav role="navigation" aria-labelledby="subsection-title">
            <ul class="govuk-list govuk-!-font-size-16">
              <li>
                <a class="govuk-link" href="<%- guidancePdf %>" target="_blank" rel="noopener noreferrer">Read the
                  guidance and watch videos</a>
              </li>
              <li>
              <% if (pupil.isAnnulled) { %>
                <a class="govuk-link" href="/service-manager/annul-pupil-undo/<%=pupil.urlSlug %>" >Undo Annulment</a>
                <% } else { %>
                  <a class="govuk-link" href="/service-manager/annul-pupil/<%=pupil.urlSlug %>" >Annul this pupils results</a>
              <% } %>
              </li>
              <li>
                <% if (!pupil.isFrozen && !pupil.isAnnulled) { %>
                  <a class="govuk-link" href="/service-manager/pupil/freeze/<%=pupil.urlSlug %>" >Freeze this pupil</a>
                <% } else if (pupil.isFrozen && !pupil.isAnnulled) { %>
                  <a class="govuk-link" href="/service-manager/pupil/thaw/<%=pupil.urlSlug %>" >Thaw this pupil</a>
                <% } %>
              </li>
              <li>
                <a class="govuk-link" href="/service-manager/pupil/move/<%=pupil.urlSlug.toLowerCase() %>" >Move pupil to different school</a>
              </li>
              <li>
                  <a class="govuk-link" href="/service-manager/pupil/edit/<%=pupil.urlSlug %>">Edit this pupil</a>
              </li>
            </ul>
          </nav>
        </aside>
      </div>
    </div>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
          <h2 class="govuk-heading-m">Pupil history</h2>
          <% if (pupilHistory.length === 0) { %>
            <p class="govuk-body">No pupil history recorded</p>
          <% } else { %>
            <p class="govuk-body">Newest actions are shown first. Check status and active check reflect the current state.</p>
            <table class="govuk-table govuk-spacious" id="pupil-history">
              <caption class="govuk-visually-hidden">Pupil history, newest first</caption>
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">Date and time</th>
                  <th scope="col" class="govuk-table__header">Action</th>
                  <th scope="col" class="govuk-table__header">Type</th>
                  <th scope="col" class="govuk-table__header" title="A mark indicates the official check currently used for this pupil">Active</th>
                  <th scope="col" class="govuk-table__header">Check status</th>
                  <th scope="col" class="govuk-table__header">Restart reason</th>
                  <th scope="col" class="govuk-table__header">Initiated by</th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                <% pupilHistory.forEach((event) => { %>
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell"><time datetime="<%= event.occurredAt.toISOString() %>"><%= formatPupilHistoryDataAndTime(event.occurredAt) %></time></td>
                    <td class="govuk-table__cell" title="<%= event.check?.checkCode %>"><%= event.action %></td>
                    <td class="govuk-table__cell"><%= event.check ? (event.check.isLiveCheck ? 'Official' : 'Try it out') : '' %></td>
                    <td class="govuk-table__cell"><%= event.check?.active ? '*' : '' %></td>
                    <td class="govuk-table__cell"><%= event.check?.checkStatus %></td>
                    <td class="govuk-table__cell"><%= event.restart?.restartReason %></td>
                    <td class="govuk-table__cell"><%= event.restart?.recordedByUser %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
      </div>
    </div>
  </main>
