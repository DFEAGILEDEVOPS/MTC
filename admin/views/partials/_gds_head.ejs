<head>
  <meta charset="utf-8" />
  <title><%- partial('partials/_page_title') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1d70b8" />

  <link rel="icon" sizes="48x48" href="<%= assetPath %>vendor/govuk-frontend/images/favicon.ico" />
  <link rel="icon" sizes="any" href="<%= assetPath %>vendor/govuk-frontend/images/favicon.svg" type="image/svg+xml" />
  <link rel="mask-icon" href="<%= assetPath %>vendor/govuk-frontend/images/govuk-icon-mask.svg" color="#1d70b8" />
  <link rel="apple-touch-icon" href="<%= assetPath %>vendor/govuk-frontend/images/govuk-icon-180.png" />

  <link href="<%= assetPath %>stylesheets/application.css?version=<%= assetsVersion %>" rel="stylesheet" />


  <meta property="og:image" content="<%= assetPath %>vendor/govuk-frontend/images/govuk-opengraph-image.png">

  <% if (isSubmitMetaRedirectUrl) { %>
  <meta http-equiv="refresh" content="<%= waitTimeBeforeMetaRedirectInSeconds %>;url=<%= metaRedirectUrl %>" />
  <% } %>
</head>
